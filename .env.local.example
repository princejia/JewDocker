# 本地开发用。生产环境请用 scripts/gen-keys.mjs 生成 .env。
#
# 本地最省事的做法是只起数据库相关服务，Next.js 用 npm run dev 跑在宿主机：
#   docker compose up -d db postgrest gateway
#   然后把 gateway 的端口映射出来（compose 里临时加 ports: "8000:80"）
#   SUPABASE_URL=http://localhost:8000

SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=

# 会话 JWT 签名密钥。生产环境缺失会直接启动失败
# 生成：openssl rand -base64 32
AUTH_SECRET=

# 对象存储（腾讯云 COS）
# COS_BUCKET 必须带 APPID 后缀，如 jewelry-1300000000
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_BASE_URL=
